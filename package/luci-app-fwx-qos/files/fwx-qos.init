#!/bin/sh /etc/rc.common
# fwx-qos - 基于 nftables limit 的每设备限速服务

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance watcher
	procd_set_param command /usr/sbin/fwx-qos-gen watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	nft delete table inet fwx_qos 2>/dev/null
}

reload_service() {
	/usr/sbin/fwx-qos-gen apply
}
